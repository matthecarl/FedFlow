OPENAI_API_KEY=<your_openai_api_key>

# one hosted and one serverlesss elasticsearch instance
ELASTICSEARCH_CAPSTONE_URL=<your_elasticsearch_url>
ELASTICSEARCH_SERVERLESS_URL=<your_elasticsearch_url>

# there are 3 different api keys to track the usage of the different services
ELASTICSEARCH_CAPSTONE_API_KEY=<your_elasticsearch_api_key>
ELASTICSEARCH_LOGSAI_API_KEY=<your_elasticsearch_api_key>
ELASTICSEARCH_SERVERLESS_API_KEY=<your_elasticsearch_api_key>

# optional toggle for enabling instrumentation during development
ENABLE_OTEL=false

# Kibana Agent Builder mirror configuration for unified /
KIBANA_URL=https://your-kibana-url
KIBANA_API_KEY=<your_kibana_api_key>
# KIBANA_USERNAME=<your_kibana_username>
# KIBANA_PASSWORD=<your_kibana_password>
# KIBANA_SPACE_ID=<optional_kibana_space_id>

# defaults to built-in Elastic AI agent when omitted
AGENT_BUILDER_AGENT_ID=elastic-ai-agent

# optional JSON map from realtime agent name -> Agent Builder agent id
# example: {"greeter":"elastic-ai-agent","VA":"elastic-ai-agent"}
AGENT_BUILDER_AGENT_MAP_JSON={}

# index for persisted Agent Builder chat events
AGENT_BUILDER_INDEX_NAME=agent-builder-chat-events-v1
